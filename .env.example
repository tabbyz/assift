# Supabase（`npx supabase status` の出力を転記。ローカルは http://127.0.0.1:54321）
NEXT_PUBLIC_SUPABASE_URL=
# 旧 anon key に相当。ブラウザに露出してよい
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# 旧 service_role key に相当。サーバーのみ。createPrivilegedClient() だけが使う
SUPABASE_SECRET_KEY=

# アプリの正準オリジン（任意。例: https://assift.com）。
# 設定するとリクエストヘッダではなくこの値で共有 URL / OAuth の redirectTo を組む。
# 本番と preview を分けたいとき、LAN（http://192.168.x.x:3000）で dev サーバーを開くときに設定する
SITE_URL=

# v1 データ移行と旧 URL 解決で使う uuid v5 の名前空間。
# RFC 準拠の UUID（version / variant のビットが正しいもの）にすること。未設定や不正な値だと
# v1 の店舗 URL（22 文字トークン）が解決されず 404 になる。一度決めたら変更しない
# （旧 URL の 308 はブラウザに永続キャッシュされ、導出される店舗 id も変わってしまう）
V1_UUID_NAMESPACE=

# Google ログイン（任意）。Supabase CLI が config.toml の env(...) を置換するため、
# `npx supabase start` を実行する shell で export しておく（.env.local は CLI に読まれない）。
# 未設定でも起動はするが、Google ボタンは「現在利用できません」相当のエラーになる
# SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
# SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=

# 自動アサイン（012）。Vercel AI Gateway の API キー（システムクレジット。BYOK は使わない）。
# 未設定なら「AI で作成」は「現在利用できません」になり、他の機能には影響しない
AI_GATEWAY_API_KEY=

# 店舗ごと1日の実行回数の上限（既定 10）
ASSIST_DAILY_LIMIT=

# 指示の解釈のモデル（既定 openai/gpt-6-sol）。評価用に上書きできる（例: anthropic/claude-sonnet-5）
ASSIST_INTERPRET_MODEL=
